**/dist/
**/coverage/
playwright-report/
test-results/
*.local
*.tsbuildinfo

# Local tooling / skills (installed per machine)
.agents/
.cursor/
skills-lock.json

# Env and secrets
.env
.env.*
!.env.example
*.pem

# Local undeployed deploy output (public address only; still machine-local)
deployment.json
deployment.preprod.json
.preprod-seed.local

# OS / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Leftover workspace checkout artifacts from other branches
