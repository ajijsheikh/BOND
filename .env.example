# Bond / MOAT environment example — never commit real seeds or mnemonics.
# Frontend Vite vars are public in the browser. Never add API keys, credentials,
# seed phrases, signing keys, witnesses, private policies, or wallet secrets.

# Demo mode is the runtime default when MIDNIGHT_NETWORK is unset / no env file is loaded.
# Copying this file alone does not enable undeployed — uncomment the local block only after `npm run local:up`.
# MIDNIGHT_NETWORK=demo

# Local undeployed network (requires: npm run local:up)
# MIDNIGHT_NETWORK=undeployed
# PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_NODE_URL=http://127.0.0.1:9944
# MIDNIGHT_INDEXER_HTTP=http://127.0.0.1:8088/api/v4/graphql
# MIDNIGHT_INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws

# After `npm run deploy:local` (Docker only — not for Atharv internet handoff)
# MOAT_CONTRACT_ADDRESS=
# MOAT_ZK_ASSETS_PATH=
# Optional override (default = local genesis 0x00…01 — NEVER use on Preprod)
# MIDNIGHT_DEPLOY_SEED=

# Preprod (public testnet — fund via https://faucet.preprod.midnight.network/)
# MIDNIGHT_NETWORK=preprod
# PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
# MIDNIGHT_INDEXER_HTTP=https://indexer.preprod.midnight.network/api/v4/graphql
# MIDNIGHT_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
# MIDNIGHT_PREPROD_SEED=                 # 64 hex chars — NEVER commit / NEVER paste in chat
# Preprod address comes from Lace browser deploy (npm run deploy:lace → deployMoatContractLowLevel).
# Do not use Node WalletFacade Preprod sync on Windows.
# MOAT_CONTRACT_ADDRESS=
# VITE_MOAT_CONTRACT_ADDRESS=

# Vite frontend (public — set after Bond deploy)
# VITE_BOND_DEFAULT_MODE=demo
# VITE_MIDNIGHT_NETWORK=preprod
# VITE_MOAT_CONTRACT_ADDRESS=       # [CORE FACT REQUIRED]: from deployMoatContractLowLevel
# VITE_ZK_ASSET_BASE_URL=/zk/moat/  # after npm run deploy:lace / sync:zk-assets
